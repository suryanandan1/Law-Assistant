# Copy to .env and fill in real values. Never commit .env.

# --- Google Vertex AI (required) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_GENAI_USE_VERTEXAI=True

# --- LLM (optional; defaults shown) ---
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_TOKENS=0            # 0 = uncapped
# GEMINI_THINKING_BUDGET=0       # 0 = thinking off; -1 = dynamic
# GEMINI_TIMEOUT_MS=60000
# GEMINI_RETRY_ATTEMPTS=3

# --- Retrieval (optional; defaults shown) ---
# RETRIEVAL_MIN_SCORE=0.5
# RERANK=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=30
# QUERY_REWRITE=auto             # auto | always | never

# --- Embedding / ingestion (optional; defaults shown) ---
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # bge-base / bge-small = far faster on CPU
# EMBED_BATCH_SIZE=32
# PDF_PATH=data/document.pdf
# OUTPUT_JSON=processed/extracted_pages.json
# LOG_FILE=logs/extraction.log
